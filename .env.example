INTERNAL_TOKEN=
# Local dev only - localhost, plain http/rtmp, matches docker-compose.yml's
# published ports. Production overrides all of these in .env.production
# (see that file's own comments).
PUBLIC_HOST=localhost
RTMP_PORT=1935
WEBRTC_PORT=8889
HLS_PORT=8888
PUBLIC_USES_TLS=False

MEDIAMTX_API_URL=http://mediamtx:9997

# Django's generic live-stream webhook - see ChannelLiveStreamWebhookView
# in backend/kis/apps/broadcasts/views.py. DJANGO_WEBHOOK_SECRET must match
# LIVE_STREAM_WEBHOOK_SECRET in Django's own .env exactly.
DJANGO_WEBHOOK_URL=http://localhost:8000/api/v1/broadcasts/live-streams/webhook/kisvideo/
DJANGO_WEBHOOK_SECRET=

# Required even in local dev - app/deps.py::require_hook_secret rejects
# MediaMTX's own hook calls without it (see mediamtx.yml). Any non-empty
# value is fine locally; production needs a real random one (see
# .env.production.example).
HOOK_SHARED_SECRET=dev-hook-secret
