# Production env — runs on the shared kis-production box, not a dedicated
# server (see docker-compose.prod.yml's header comment for the full
# reasoning). Fill in real values before:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

INTERNAL_TOKEN=
# The same value must be set on the Django side as
# KIS_VIDEO_LIVE_SERVICE_INTERNAL_TOKEN. Generate with:
#   openssl rand -base64 48
# (same rotation posture as kisvideo's own INTERNAL_TOKEN / Django's
# DJANGO_INTERNAL_TOKEN - rotating means updating both sides together.)

# The EXISTING api.kingdomimpactventures.org domain, reused deliberately -
# not a new subdomain. RTMP ingest connects directly to
# api.kingdomimpactventures.org:1935 (no nginx/TLS involved, RTMP doesn't
# need it); WHIP/HLS go out on their own ports (8889/8888) on this SAME
# domain, fronted by NEW listen directives added to the nginx server block
# that already handles api.kingdomimpactventures.org — reusing its
# existing certbot cert rather than provisioning a new one, since a new
# subdomain would need a DNS record nobody has created and a fresh ACME
# challenge. See the nginx snippet this repo ships (nginx-live-streaming.conf.snippet)
# for the exact directives, reviewed before being applied to the live config.
PUBLIC_HOST=api.kingdomimpactventures.org
RTMP_PORT=1935
WEBRTC_PORT=8889
HLS_PORT=8888
PUBLIC_USES_TLS=True

MEDIAMTX_API_URL=http://mediamtx:9997

DJANGO_WEBHOOK_URL=https://api.kingdomimpactventures.org/api/v1/broadcasts/live-streams/webhook/kisvideo/
# Base URL for the small number of Django endpoints app/recording.py
# calls DIRECTLY (not through the generic webhook contract above) -
# requesting a presigned S3 upload URL and reporting archive
# success/failure for a finished recording. Same auth (X-Live-Webhook-
# Secret: DJANGO_WEBHOOK_SECRET below) and trust boundary as the webhook
# above - see app/recording.py's own request headers.
DJANGO_API_BASE_URL=https://api.kingdomimpactventures.org/api/v1
# Deliberately the PUBLIC https URL, not an internal kis-production-network
# container address, even though both services now share that network -
# going out through nginx and back is a negligible cost for a webhook that
# only fires on stream start/stop (not a hot path), and it avoids having
# to reason about whether Django's ALLOWED_HOSTS/CSRF host validation
# would accept a request whose Host header doesn't match
# api.kingdomimpactventures.org. Not worth the risk for this one call.
# Must match LIVE_STREAM_WEBHOOK_SECRET in Django's production .env.django
# exactly (see ChannelLiveStreamWebhookView's generic-provider fallback).
DJANGO_WEBHOOK_SECRET=

# Shared secret MediaMTX's own hook calls authenticate with (X-Hook-Secret
# header) - see app/deps.py::require_hook_secret. Generate with:
#   openssl rand -base64 48
# Unrelated to INTERNAL_TOKEN/DJANGO_WEBHOOK_SECRET above - three
# different caller identities (Django, Django again, MediaMTX), three
# different secrets.
HOOK_SHARED_SECRET=
